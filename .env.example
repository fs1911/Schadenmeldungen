# Resend API-Key (https://resend.com/api-keys)
RESEND_API_KEY=
# Absender – Domain muss bei Resend verifiziert sein
MAIL_FROM=Schadenmeldung <schadenmeldung@example.ch>
# Empfänger der Schadenmeldung (Test: filip.subara@tozzo.ch, produktiv: schaden@tozzo.ch). Mehrere mit Komma.
REPORT_TO=filip.subara@tozzo.ch
# Empfänger der Nachricht bei «Fehlerhafte Pläne» (Test: filip.subara@tozzo.ch; Bauführer-Adresse folgt)
PLANS_NOTIFY_TO=filip.subara@tozzo.ch
# Max. Gesamtgrösse aller Dateien pro Meldung in MB (Netlify-Standard 5, Server-Standard 35)
MAX_TOTAL_UPLOAD_MB=
# Nur hinter einem Reverse-Proxy: X-Forwarded-For für die IP-Begrenzung verwenden
TRUST_PROXY=false
PORT=3000
